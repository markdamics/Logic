{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logic",
  "version": "0.6.0",
  "identifier": "com.logic.analyzer.desktop",
  "build": {
    "frontendDist": "../frontend-placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Logic",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "resources/app.jar": "app.jar",
      "resources/jre": "jre"
    }
  }
}
