# Maven build output
target/

# H2 database files (backend dev data)
backend/data/
*.mv.db
*.trace.db

# Node / frontend build output
node_modules/
dist/

# Frontend embedded into the backend jar during desktop/production builds
# (see desktop/build.sh and Dockerfile) - not meant to be committed
backend/src/main/resources/static/

# Desktop build artifacts: bundled JRE + jar staged for Tauri packaging
desktop/src-tauri/resources/

# Compiled class file
*.class

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
